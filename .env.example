# ---------- Server ----------
PORT=4000
NODE_ENV=development
SESSION_SECRET=change_me_to_a_long_random_string
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ---------- Postgres ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# ---------- Redis (BullMQ + rate-limit counters) ----------
REDIS_URL=redis://localhost:6379

# ---------- Elasticsearch ----------
ELASTIC_NODE=http://localhost:9200
ELASTIC_INDEX=emails

# ---------- Ethereal (fake SMTP) ----------
# Leave blank to auto-create a fresh Ethereal test account on boot (logged to console),
# or set real Ethereal creds from https://ethereal.email to keep them stable across restarts.
ETHEREAL_USER=
ETHEREAL_PASS=

# ---------- Google OAuth (Login) ----------
# https://console.cloud.google.com/apis/credentials -> OAuth Client ID (Web application)
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---------- Slack OAuth (rate-limit notifications) ----------
# https://api.slack.com/apps -> OAuth & Permissions
# Scopes needed: incoming-webhook
# Redirect URL: http://localhost:4000/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ---------- Scheduler / rate limiting defaults (all overridable per-request) ----------
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=200
WORKER_CONCURRENCY=5
